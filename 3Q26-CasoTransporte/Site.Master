<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.master.vb" Inherits="_3Q26_CasoTransporte.SiteMaster" %>

<!DOCTYPE html>

<html lang="es">
<head runat="server">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8"/>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Control de Transporte</title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

</head>
<body>
    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-md navbar-toggleable-md navbar-dark" style="background-color:#159f9c;">
            <div class="container">
                <a class="navbar-brand fw-bold" runat="server" href="~/">Control de Transporte</a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Alternar navegación" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse d-md-inline-flex justify-content-between">
                    <%-- Cada grupo trabaja en la página de su módulo (carpeta Pages) --%>
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/">Inicio</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Propietarios">Propietarios</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Vehiculos">Vehículos</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/TiposMulta">Tipos de multa</a></li>
                        <li class="nav-item"><a class="nav-link" runat="server" href="~/Pages/Multas">Multas</a></li>
                    </ul>
                    <asp:PlaceHolder ID="phUsuario" runat="server" Visible="false">
                        <span class="navbar-text text-white me-3">
                            <asp:Literal ID="litUsuario" runat="server" />
                        </span>
                        <asp:LinkButton ID="lnkCerrarSesion" runat="server" CssClass="btn btn-outline-light btn-sm"
                            OnClick="lnkCerrarSesion_Click" CausesValidation="false">Cerrar sesión</asp:LinkButton>
                    </asp:PlaceHolder>
                </div>
            </div>
        </nav>
        <div class="container body-content py-4">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
            <hr />
            <footer>
                <p class="text-muted small">&copy; <%: DateTime.Now.Year %> - Control de Transporte · Programación 3</p>
            </footer>
        </div>
        <%-- SweetAlert2 debe cargarse antes de los mensajes que registra SwalUtils --%>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
</body>
</html>
