<?xml version="1.0" encoding="utf-8"?>
<!--
  PLANTILLA de conexión. Cada integrante:
    1. Copia este archivo y lo renombra a ConnectionStrings.config (misma carpeta que Web.config).
    2. Cambia Server por el nombre de su instancia de SQL Server.
  ConnectionStrings.config está en .gitignore: NO se sube al repositorio
  (así no se pisan las conexiones entre compañeros ni se publican contraseñas).

  Ejemplos de Server:
    localhost                    instancia por defecto
    .\SQLEXPRESS                 SQL Server Express
    MI-PC\MSSQLSERVER2025        instancia con nombre
  Con usuario y contraseña de SQL en lugar de Trusted_Connection:
    Server=...;Database=TransporteDB;User Id=...;Password=...;TrustServerCertificate=True;
-->
<connectionStrings>
  <add name="ConexionTransporteDB"
       connectionString="Server=localhost;Database=TransporteDB;Trusted_Connection=True;TrustServerCertificate=True;"
       providerName="System.Data.SqlClient" />
</connectionStrings>
